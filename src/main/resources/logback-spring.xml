<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="applicationName" source="spring.application.name" />
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active"
        defaultValue="default" />

    <!-- 로그 출력 패턴 정의 (Trace ID, Span ID, MDC 환경 변수 포함) -->
    <property scope="context" name="LOG_PATTERN"
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %3p [${applicationName:-application},%X{traceId:-},%X{spanId:-}] [%X{env:-}] [%X{tenant:-}] [%X{user:-}] [%X{branch:-}] ${PID:- } --- [%15.15t] %-40.40logger{39} : %msg%n" />

    <!-- 로그 파일 경로/롤링 크기는 배포 환경에서 JVM 시스템 프로퍼티로 오버라이드 가능 (예: -Ddemo.logging.path=/var/log/app) -->
    <property name="LOG_DIR" value="${demo.logging.path:-logs}" />
    <property name="LOG_BASE_PATH" value="${LOG_DIR}/${activeProfile}" />
    <property name="MAX_FILE_SIZE" value="${demo.logging.rolling.max-file-size:-100MB}" />

    <!-- 콘솔 로그 출력 설정 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>utf8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 파일 로그 출력 및 롤링 정책 설정 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_BASE_PATH}/${applicationName}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_BASE_PATH}/archive/${applicationName}.%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <!-- 로그 파일 보관 주기(일) 및 총 용량 제한 -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>utf8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Hibernate SQL 바인딩 파라미터 로깅 설정 (Hibernate 6 이상) -->
    <logger name="org.hibernate.orm.jdbc.bind" level="trace" additivity="false">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- 기본 루트 로거 설정 -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

    <!-- 애플리케이션 종료 시 로그 백그라운드 자원 정리 -->
    <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook" />
</configuration>